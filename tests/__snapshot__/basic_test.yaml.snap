renders a Helm test pod against the API service:
  1: |
    containers:
      - args:
          - |
            curl -fsS -m 10 http://RELEASE-NAME-server:8081/api/health && echo OK
        command:
          - /bin/sh
          - -c
        image: ghcr.io/brian7704/opentakserver@sha256:96190757acb799fa9d1e3be50469706610b64fbc9c5c1ed280e55fa6f0b06e4d
        name: test
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
              - ALL
          readOnlyRootFilesystem: true
    restartPolicy: Never
    securityContext:
      runAsGroup: 1000
      runAsNonRoot: true
      runAsUser: 1000
      seccompProfile:
        type: RuntimeDefault
