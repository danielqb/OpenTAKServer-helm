renders a Helm test pod against the API service:
  1: |
    containers:
      - args:
          - |
            curl -fsS -m 10 http://RELEASE-NAME-server:8081/api/health && echo OK
        command:
          - /bin/sh
          - -c
        image: ghcr.io/danielqb/opentakserver@sha256:7bef70e560195d7f6ae7428364321fef6923f8f5c824e18587d80f5042698952
        name: test
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
              - ALL
          readOnlyRootFilesystem: true
    restartPolicy: Never
    securityContext:
      runAsGroup: 1000
      runAsNonRoot: true
      runAsUser: 1000
      seccompProfile:
        type: RuntimeDefault
