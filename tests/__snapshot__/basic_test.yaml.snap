renders a Helm test pod against the API service:
  1: |
    containers:
      - args:
          - |
            curl -fsS -m 10 http://RELEASE-NAME-server:8081/api/health && echo OK
        command:
          - /bin/sh
          - -c
        image: ghcr.io/danielqb/opentakserver@sha256:be348ac743a38075557f7f7eb532e16d5606c08e3001629dc646c99856e2226c
        name: test
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
              - ALL
          readOnlyRootFilesystem: true
    restartPolicy: Never
    securityContext:
      runAsGroup: 1000
      runAsNonRoot: true
      runAsUser: 1000
      seccompProfile:
        type: RuntimeDefault
